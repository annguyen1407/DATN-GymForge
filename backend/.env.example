# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/gymforge_db"

# JWT Configuration
JWT_ACCESS_SECRET="replace-with-access-token-secret"
JWT_REFRESH_SECRET="replace-with-refresh-token-secret"
JWT_EXPIRES_IN="15m"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

# Application Configuration
PORT=3000
NODE_ENV="development"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Backend URL (for email links)
BACKEND_URL="http://localhost:3000"

# Email Configuration (SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM_NAME="GymForge"
MAIL_FROM_ADDRESS="noreply@gymforge.com"
SUPPORT_EMAIL="support@gymforge.com"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
