# Database
DATABASE_URL="postgresql://username:password@localhost:5432/gymforge_db"

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="replace-with-access-token-secret"
JWT_REFRESH_SECRET="replace-with-refresh-token-secret"
JWT_EXPIRES_IN="15m"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
USE_IN_MEMORY_CACHE=0

# Email / SMTP
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="your-email@example.com"
MAIL_PASS="your-app-password"
MAIL_FROM_NAME="GymForge"
MAIL_FROM_ADDRESS="noreply@example.com"
SUPPORT_EMAIL="support@example.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Prisma
# Usually not needed locally. Some tests may set this to "binary".
# PRISMA_CLIENT_ENGINE_TYPE="binary"
